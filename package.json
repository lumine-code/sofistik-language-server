{
  "name": "@lumine-code/sofistik-language-server",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Provides SOFiSTiK CADINP language services over LSP.",
  "keywords": [
    "cadinp",
    "sofistik",
    "language-server",
    "lsp",
    "structural-analysis"
  ],
  "repository": "https://github.com/lumine-code/sofistik-language-server",
  "bugs": {
    "url": "https://github.com/lumine-code/sofistik-language-server/issues"
  },
  "license": "MIT",
  "private": true,
  "main": "lib/server.js",
  "bin": {
    "sofistik-language-server": "bin/cli.js"
  },
  "exports": {
    ".": "./lib/server.js",
    "./bin/cli.js": "./bin/cli.js",
    "./finder": "./lib/finder.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "docs",
    "test"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm test && npm pack --dry-run"
  },
  "dependencies": {
    "@lumine-code/sofistik-schema": "github:lumine-code/sofistik-schema#51580a8c7eec1c54ca1916576432a0f99a7f6ed6",
    "@lumine-code/sofistik-context": "github:lumine-code/sofistik-context#1a23b04a747e4902e0934d4c60500987a50d514a",
    "vscode-languageserver": "10.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "vscode-jsonrpc": "^9.0.3"
  }
}
