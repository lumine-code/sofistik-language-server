{
  "name": "@lumine-code/sofistik-language-server",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Provides SOFiSTiK CADINP language services over LSP.",
  "keywords": [
    "cadinp",
    "sofistik",
    "language-server",
    "lsp",
    "structural-analysis"
  ],
  "repository": "https://github.com/lumine-code/sofistik-language-server",
  "bugs": {
    "url": "https://github.com/lumine-code/sofistik-language-server/issues"
  },
  "license": "MIT",
  "private": true,
  "main": "lib/server.js",
  "bin": {
    "sofistik-language-server": "bin/cli.js"
  },
  "exports": {
    ".": "./lib/server.js",
    "./bin/cli.js": "./bin/cli.js",
    "./finder": "./lib/finder.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "docs",
    "test"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm test && npm pack --dry-run"
  },
  "dependencies": {
    "@lumine-code/sofistik-schema": "github:lumine-code/sofistik-schema#5807209442069b505e5f3e7c0cb40c92bf178c86",
    "@lumine-code/sofistik-context": "github:lumine-code/sofistik-context#b8c849aec69ec146342ebe5bbf5e023bbafe2b1c",
    "vscode-languageserver": "11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "vscode-jsonrpc": "^10.0.0"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.5"
    }
  }
}
